# Plivo credentials 
PLIVO_AUTH_ID=your_auth_id
PLIVO_AUTH_TOKEN=your_auth_token

# Numbers in E.164 format
PLIVO_FROM_NUMBER=+918035454161
ASSOCIATE_NUMBER=+912264236412
DEFAULT_TO_NUMBER=+91XXXXXXXXXX

# Public HTTPS URL that forwards to this app (ngrok)
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Your birthdate in DDMM (March 15 -> 1503)
OTP_CODE=1503

# Public HTTPS MP3 played on "press 1"
AUDIO_URL=https://s3.amazonaws.com/plivocloud/music.mp3

# Set to true to reject webhooks without a valid X-Plivo-Signature-V3
VALIDATE_SIGNATURE=false
